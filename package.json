  "license": "MIT",
  "private": true,
  "keywords": [
    "wails",
    "go",
    "vite",
    "vue3",
    "vue"
  ],
  "debug": {
    "env": {
      "VITE_DEV_SERVER_URL": "http://127.0.0.1:3344/",
      "VSCODE_DEBUG": true
    }
  },
  "type": "module",
  "scripts": {
    "dev": "wails3 dev -config build/config.yml",
    "dev:wails:frontend": "npx vite --config frontend/vite.config.ts",
    "build:wails:frontend": "npx vite build --config frontend/vite.config.ts",
    "build:wails": "npm run build:wails:frontend && wails3 generate bindings && task generate:icons && wails3 build",
    "generate:icons": "task generate:icons"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.4",
