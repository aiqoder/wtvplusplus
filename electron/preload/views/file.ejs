<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>橙子pro内网分享</title>
  <link rel="stylesheet" href="/iconfont.css">
</head>

<body>
  <ol>
    <% files.forEach(function(item){ %>
      
        <% if (item.type == 'file') { %>
          <li>
            <i class="iconfont icon-wenjian"></i> <a href="<%= item.name %>"><%= item.name %></a>
          </li>
        <% } %>
        <% if (item.type == 'dir') { %>
          <li>
            <i class="iconfont icon-wenjianjia"></i> <a href="<%= item.name %>/"><%= item.name %></a>
          </li>
        <% } %>
      <% }); %>
  </ol>
</body>

</html>